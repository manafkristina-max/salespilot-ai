# SalesPilot AI — локальная конфигурация. Скопируйте в .env и заполните только нужное.
# Файл .env не коммитится и не должен пересылаться. По умолчанию всё внешнее ВЫКЛЮЧЕНО.

# --- Сервер
SALESPILOT_HOST=127.0.0.1          # не меняйте: в MVP нет аутентификации
SALESPILOT_PORT=8000
# SALESPILOT_DB=./data/salespilot.db

# --- LLM (Writer Agent). mock = детерминированные шаблоны, без затрат.
# anthropic = Anthropic Messages API (ПЛАТНО, по токенам). Работает только в Live mode.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Настоящий агент целиком включается одной командой: ./start.sh --live
#     (рабочий режим + Wikidata + чтение сайтов + Claude через подписку Claude Code).

# claude_cli = Claude через вашу подписку Claude Code (без ключа и доплат, расходует лимит подписки).
#              Вызовы изолированы как в Harvey: claude -p --safe-mode, без инструментов и вашей конфигурации.
# LLM_PROVIDER=claude_cli
# CLAUDE_MODEL=                     # пусто = модель по умолчанию в Claude Code

# --- Поиск реальных компаний в Wikidata (открытые данные, бесплатно).
LIVE_DISCOVERY_ENABLED=false

# --- Research Agent: загрузка публичных сайтов компаний (бесплатно, без ключа).
# Использует SSRF-защищённый HTTP-клиент из Harvey. Работает только в Live mode.
LIVE_RESEARCH_ENABLED=false
# VPN с подменой DNS (Happ, Clash, sing-box в режиме TUN/fake-IP) отдаёт сайтам адреса 198.18.x.x,
# которые защита от SSRF блокирует. true разрешает ТОЛЬКО этот диапазон (localhost и локальная сеть
# остаются закрыты). ./start.sh --live включает это сам, если обнаружит такой VPN.
SALESPILOT_ALLOW_VPN_FAKE_IP=false

# --- Sender Agent: реальная отправка через SMTP.
# Даже при заполненных полях письмо уходит только если: Live mode + LIVE_SENDING_ENABLED=true
# + письмо одобрено вручную + подтверждение в диалоге + компания не демо + получатель указан.
LIVE_SENDING_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
